# 關閉 Next.js 遙測（私人應用不需上傳使用統計；亦可避開部分 Windows 環境的設定檔寫入錯誤）
NEXT_TELEMETRY_DISABLED=1

# ── Demo 模式（部署到 Vercel 時使用）──────────────
# 設為 1 時：停用 SQLite（個人紀錄不保留）、停用 Prowlarr/qBittorrent（下載功能關閉）
# 本機開發請勿設定此變數
DEMO_MODE=

# ── TMDB（電影資料）─────────────────────────────
# 到 https://www.themoviedb.org/settings/api 申請
# 可填 v3 api_key，或 v4 read access token（兩者擇一即可，程式會自動判斷）
TMDB_API_KEY=

# ── Prowlarr（種子搜尋，跑在同一台機器）──────────
# API 金鑰位置：Prowlarr → Settings → General → API Key
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# ── qBittorrent（加入下載，跑在同一台機器）────────
# 帳密設定位置：qBittorrent → Preferences → Web UI
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
