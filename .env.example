# 關閉 Next.js 遙測（私人應用不需上傳使用統計；亦可避開部分 Windows 環境的設定檔寫入錯誤）
NEXT_TELEMETRY_DISABLED=1

# ── 資料庫（Neon Postgres）──────────────────────
# 收藏 / 想看 / 已看過 / 評分 都存在這裡。
# Vercel 上由 Neon 整合自動注入，不需手動設定；本機開發要自己填。
# 到 Neon Console 的 Connection Details 複製，格式：
#   postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# ── 擁有者鎖（整站只給一個人用）─────────────────
# 沒設定這兩個變數，全站一律鎖住，連自己也進不去——這是刻意的，
# 設定漏掉時整站關門，比預設放行安全。
#
# OWNER_PASSCODE：你要輸入的通行碼。這是唯一一道防線，請用長一點的，
# 不要用四位數 PIN；serverless 環境沒有可靠的共享狀態做 rate limit。
# OWNER_SECRET：cookie 的簽章金鑰，隨機字串，不需要記住。
# 換掉 OWNER_SECRET 會讓所有裝置上的解鎖狀態立即失效。
#
# 產生 OWNER_SECRET：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OWNER_PASSCODE=
OWNER_SECRET=

# ── TMDB（電影資料）─────────────────────────────
# 到 https://www.themoviedb.org/settings/api 申請
# 可填 v3 api_key，或 v4 read access token（兩者擇一即可，程式會自動判斷）
TMDB_API_KEY=
